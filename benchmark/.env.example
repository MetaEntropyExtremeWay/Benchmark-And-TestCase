# benchmark 评测配置（复制为 .env 并填值；.env 不进任何仓、不外传）
# 复制本文件后：cp .env.example .env

# —— 产品仓根（缺省 = 本仓上级工作区里的兄弟目录自动探测；探测不到才必填）——
#BENCH_MC_ROOT=D:/path/to/lmg-mem     # mc 记忆服务仓（jar / dev PG / embed 凭据）
#BENCH_LMG_ROOT=D:/path/to/lmg-exo    # lmg 编排全家仓（daemon / exo packages / 其 .env LLM 配置）

# —— mc 检索直测线（BENCH_MC_* 前缀，prepare / recall / clean 读）——
# mc bench 实例地址：缺省 = 按数据集正典坐标（lme→8081 / locomo→8082）。
# 别钉死单域坐标——跨域硬门会拦（报错自带修法）。
#BENCH_MC_MEM_URL=http://127.0.0.1:8081

# ingest 后 outbox 排空等待（全量灌库为小时级；缺省 30 分钟）
#BENCH_MC_DRAIN_MS=1800000

# —— judge / 组件线（BENCH_* 前缀，judge-qa 读）——
# judge 模型坐标（跑分协议要求钉死并记录进读数）
BENCH_LLM_BASE_URL=
BENCH_LLM_API_KEY=
BENCH_JUDGE_MODEL=
BENCH_LLM_TIMEOUT_MS=180000

# —— lmg 产品链线（BENCH_LMG_* 前缀，formation / snapshot / qa / judge-qa 读）——
# 链线 mem 实例地址：缺省 = 按数据集正典坐标（lme→8084 / locomo→8085）。跨域硬门同上。
#BENCH_LMG_MEM_URL=http://127.0.0.1:8084
# 链线答/灌共用 daemon 端口（formation 收尾 worker 与答题 daemon 分时复用）
#BENCH_LMG_DAEMON_PORT=5894
# formation 排空预算（outbox/收尾事件/向量嵌全清；缺省 30 分钟）
#BENCH_LMG_DRAIN_MS=1800000
